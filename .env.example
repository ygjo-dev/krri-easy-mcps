# KRRI EASY MCPs BFF 설정 예시. 복사해 .env 로 두고 `set -a; . ./.env; set +a` 로 읽는다. .env 는 commit 하지 않는다.
# 내부 서비스 주소는 BFF(backend) 에만 둔다. web/ 쪽 env 에 넣지 않는다.

# 설정 폴더 (기본: 저장소의 config/)
# KEM_CONFIG_DIR=

# Gateway: mock | live. live 가 실패해도 mock 으로 넘어가지 않는다 (502).
KEM_GATEWAY_MODE=mock
# live 에서 필수. 예: 개발 장비 http://127.0.0.1:3000 . credential 은 쓰지 않는다.
KEM_GATEWAY_BASE_URL=
# Gateway GET /api/tools 는 부를 때마다 MCP tools/list refresh 를 일으킨다. 결과를 이 초만큼 재사용한다.
KEM_GATEWAY_CACHE_SECONDS=60

# agentic_ai: mock | live. live 는 기존 POST /chat/stream 을 부른다. 실패해도 mock 으로 넘어가지 않는다 (502).
KEM_AGENTIC_AI_MODE=mock
# live 에서 필수. 예: 개발 장비 http://127.0.0.1:8000 . credential 은 쓰지 않는다.
KEM_AGENTIC_AI_BASE_URL=
# 한 요청(LLM 해석 + KRRI 실행)을 기다리는 초. agentic 쪽 KRRI 호출 제한(300초)보다 길게 둔다.
KEM_AGENTIC_AI_TIMEOUT_SECONDS=360

# EASY 자체 계정 · 세션 · 계정 도구함 DB (SQLite). KRRI_ASAP 로그인과 별개다. 기본: 저장소의 data/easy.db (gitignore)
# KEM_DB_PATH=
# AI Skills package 파일 폴더 (metadata 는 위 DB). 기본: KEM_DB_PATH 옆 skills/
# KEM_SKILLS_DIR=
# EASY 로그인 세션 수명 (시간)
KEM_SESSION_HOURS=168
# 개발 · 검증용 초기 관리자 계정 (role ADMIN). DB 에 이 이름이 없을 때 한 번만 만든다 (이미 있으면 비밀번호를 바꾸지 않는다).
# 운영에 쓸 값이 아니다. 설정하지 않으면 admin / admin.
# KEM_ADMIN_USERNAME=admin
# KEM_ADMIN_PASSWORD=admin

# web dev 서버(Vite) 가 /api 를 넘길 BFF 주소. Node 쪽 값이라 브라우저 번들에 안 들어간다.
# KEM_BFF_URL=http://127.0.0.1:8610
